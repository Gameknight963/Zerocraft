<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>mszcubemod</RootNamespace>
    <AssemblyName>Zerocraft</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>14</LangVersion>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="dependencies\**" />
    <EmbeddedResource Remove="dependencies\**" />
    <None Remove="dependencies\**" />
  </ItemGroup>

  <ItemGroup>

		<Reference Include="Multiside.shared">
			<HintPath>dependencies\Multiside.shared.dll</HintPath>
		</Reference>
		<Reference Include="PhotonClient">
			<HintPath>dependencies\PhotonClient.dll</HintPath>
		</Reference>
		<Reference Include="InventoryFramework">
			<HintPath>dependencies\InventoryFramework.dll</HintPath>
		</Reference>
		
		<Reference Include="MelonLoader">
			<HintPath>$(MelonAssembliesPath)\MelonLoader.dll</HintPath>
		</Reference>
		
		<Reference Include="Assembly-CSharp">
			<HintPath>$(GameAssembliesPath)\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(GameAssembliesPath)\UnityEngine.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(GameAssembliesPath)\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(GameAssembliesPath)\UnityEngine.ImageConversionModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(GameAssembliesPath)\UnityEngine.InputLegacyModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>$(GameAssembliesPath)\UnityEngine.PhysicsModule.dll</HintPath>
		</Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy &quot;$(SolutionDir)blocks&quot; &quot;$(GamePath)\Mods\Zerocraft\&quot; /E /I /Y" />
		<Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(GamePath)/Mods/&quot;" />
	</Target>

</Project>
